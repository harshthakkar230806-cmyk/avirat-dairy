# Found in Supabase: Project Settings -> API -> Project API keys -> "anon public"
# Safe to use in the browser. It only allows what your RLS policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_foqYM4EL788l_98HJ5GQiQ_Uh-qokwS

# Found in Supabase: Project Settings -> API -> Project API keys -> "service_role"
# EXTREMELY SENSITIVE. This key bypasses ALL Row Level Security.
# It must NEVER be used in any file inside src/app that runs in the browser.
# We will only ever use it in secure server-only code (e.g. admin billing jobs).
SUPABASE_SERVICE_ROLE_KEY=
